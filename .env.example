# Application
APP_ENV=development
APP_NAME=Campus Book Loop
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Security
# Replace with a secure random value. Never commit the real secret.
TOKEN_SECRET=change-me-in-local-environment
TOKEN_EXPIRE_MINUTES=240
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=campus_book_loop
POSTGRES_USER=campus_book_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://campus_book_app:change-me@localhost:5432/campus_book_loop
SEED_ON_STARTUP=true
# Containers run `alembic upgrade head`; keep schema creation disabled there.
AUTO_CREATE_SCHEMA=false

# Redis
REDIS_URL=redis://redis:6379/0

# Object storage
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=book-images

# AI
MODEL_DIR=/app/models
PRICE_MODEL_VERSION=experimental
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# Payment sandbox
PAYMENT_PROVIDER=alipay_sandbox
PAYMENT_MODE=sandbox
PAYMENT_CALLBACK_BASE_URL=http://localhost:8000/api/v1/payments/callback

# Feature flags
ENABLE_IMAGE_CONDITION_MODEL=false
ENABLE_REAL_PAYMENT=false
ENABLE_CAMPUS_SSO=false
